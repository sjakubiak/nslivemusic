{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nslivemusic",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Serve files like /google977941eafd54a7f0.html as-is, without redirecting
    // to the address with ".html" removed (Google's site check needs the exact URL).
    "html_handling": "none"
  },
  "observability": { "enabled": true },
  // Regular nights and suggestions (/suggest, /admin). Free, no pausing.
  "d1_databases": [
    { "binding": "DB", "database_name": "nslivemusic", "database_id": "c7308b27-45db-42b5-b3a3-c88a0bf7b3dd" }
  ]
}
